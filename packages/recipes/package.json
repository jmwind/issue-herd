{
  "name": "@weawr/recipes",
  "version": "0.2.8",
  "private": true,
  "description": "Versioned prompts and brief rendering. The prompt files ship under dist/prompts; reading them is the CLI's job.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@weawr/protocol": "*"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5})\" && tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "dev": "node build.mjs && tsc -p tsconfig.json --watch --preserveWatchOutput"
  }
}
