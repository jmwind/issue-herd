{
  "name": "@weawr/engine",
  "version": "0.2.8",
  "private": true,
  "description": "The factory: lifecycle, commands, observations and canonical projections, with its tracker/herdr/git/persistence adapters.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@weawr/protocol": "*",
    "@weawr/recipes": "*"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  }
}
