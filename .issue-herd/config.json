{
  "tracker": "github",
  "pollSeconds": 30,
  "lookbackDays": 30,
  "maxConcurrent": 3,
  "roles": ["impl", "review", "usability"],
  "defaults": {
    "worktree": "self",
    "branch": "{{issueBranchName}}{{roleSuffix}}",
    "permissionMode": "auto",
    "agentArgs": [],
    "maxConcurrent": 2,
    "prompt": "prompts/default.md",
    "instructionsFile": "instructions.md",
    "claimLabel": "herdr",
    "skipIfAssignedToOthers": true,
    "onPickup": {
      "comment": true,
      "state": null,
      "assignToMe": true
    },
    "onDone": {
      "comment": true,
      "state": null,
      "notify": true,
      "closeWorkspace": false
    },
    "onBlocked": {
      "comment": true,
      "notify": true
    },
    "onIdle": {
      "comment": true,
      "notify": true
    }
  },
  "rules": [
    {
      "name": "implement",
      "role": "impl",
      "match": "label:ai and not label:ready-for-review",
      "model": "claude-fable-5-1"
    },
    {
      "name": "tech-lead",
      "role": "review",
      "match": "label:ai and label:ready-for-review",
      "basedOn": "impl",
      "agentKind": "codex",
      "model": "gpt-6-astra",
      "effort": "high",
      "prompt": "prompts/review-lead.md"
    },
    {
      "name": "usability",
      "role": "usability",
      "match": "label:ai and label:ready-for-review",
      "basedOn": "impl",
      "model": "opus",
      "effort": "high",
      "prompt": "prompts/review-usability.md"
    }
  ]
}
